{
  "name": "passport-photo-generator",
  "version": "1.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/run-tests.js && node --no-warnings scripts/test-face-align.mjs",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "node scripts/download-models.js && node scripts/download-bg-models.js && npm run build && electron-builder",
    "dist": "npm run electron:build",
    "android:sync": "npx cap sync android",
    "android:build": "npm run build && npx cap sync android && cd android && .\\gradlew.bat assembleDebug",
    "android:run": "npx cap run android",
    "download-bg-models": "node scripts/download-bg-models.js",
    "download-face-models": "node scripts/download-models.js",
    "release": "npm run electron:build -- --publish always"
  },
  "build": {
    "appId": "com.passportphoto.generator",
    "productName": "Passport Photo Generator",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "out/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "md-musharraf",
        "repo": "passport-size-photo"
      }
    ]
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@imgly/background-removal": "^1.7.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@types/sharp": "^0.31.1",
    "electron-updater": "^6.8.9",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.59.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  }
}
